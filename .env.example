# Database
# PostgreSQL connection string used by Prisma and the pg adapter.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"

# NextAuth / Auth.js
# Generate with: npx auth secret
# Or: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# The canonical URL of the app. Required in production.
# In development, NextAuth defaults to http://localhost:3000.
AUTH_URL="http://localhost:3000"
